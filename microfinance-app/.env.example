# Database connection (PostgreSQL - Neon)
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Authentication configuration
JWT_SECRET="your-secret-key-for-jwt-encryption"

# Admin bootstrap email (creates the admin account on first run only;
# the password lives in the database and is changed via Settings after login).
# To set the initial password for a brand-new database, pass it inline instead
# of storing it here, e.g.: ADMIN_PASSWORD=temp-pass npm run seed
# If omitted, a random password is generated and printed once during seeding.
ADMIN_EMAIL="admin@example.com"

# Email Configuration (Gmail SMTP with App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM_NAME="Microfinance Management System"
